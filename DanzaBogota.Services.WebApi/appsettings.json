{
  "ConnectionStrings": {
    // Credenciales locales de desarrollo se leen de user-secrets:
    // dotnet user-secrets set "ConnectionStrings:DefaultConnection" "..."
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    // La llave de firma se lee de user-secrets:
    // dotnet user-secrets set "Jwt:Key" "..."
    "Key": "",
    "Issuer": "DanzaBogotaApi",
    "Audience": "DanzaBogotaClient",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  }
}